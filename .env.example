# Copy to .env and edit. docker compose reads .env automatically.

# OPC UA endpoint of the gantry PLC.
OPC_URI=opc.tcp://192.168.1.33:4840

# OPC UA namespace index the gantry nodes live in.
OPC_NAMESPACE=4

# Host port Redis is published on (clients outside docker connect here).
REDIS_HOST_PORT=6379

# Log level: error | warn | info | debug | trace
RUST_LOG=info

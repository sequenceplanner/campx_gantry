# Copy to .env and edit. docker compose reads .env automatically.

# OPC UA endpoint of the gantry PLC.
OPC_URI=opc.tcp://192.168.1.33:4840

# OPC UA namespace index the gantry nodes live in.
OPC_NAMESPACE=4

# Host port Redis is published on (clients outside docker connect here).
REDIS_HOST_PORT=6379

# Log level: error | warn | info | debug | trace
RUST_LOG=info

# ROS 2 distro the image is built on.
ROS_DISTRO=lyrical

# ROS 2 domain the action server joins; clients must use the same one.
ROS_DOMAIN_ID=0

# Name of the ROS 2 action server, and how many seconds a move may take.
GANTRY_ACTION_NAME=/gantry/move
GANTRY_GOAL_TIMEOUT=120

# Topic the PLC's read values are published on.
GANTRY_STATE_TOPIC=/gantry/state

# The UR robot's joint states; a goal aborts unless the robot is at home.
GANTRY_JOINT_STATES_TOPIC=/joint_states
